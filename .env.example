# Copy to .env before shared/server deployment and replace all placeholder secrets.
SAR_LRA_IMAGE=sar-lra:cpu
SAR_LRA_INPUT_DIR=./input
SAR_LRA_CLI_OUTPUT_DIR=./results
SAR_LRA_API_PORT=8000
SAR_LRA_MINIO_API_PORT=9000
SAR_LRA_MINIO_CONSOLE_PORT=9001

# MinIO credentials. DO NOT use these defaults outside local development.
MINIO_ROOT_USER=sar-lra-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
SAR_LRA_S3_BUCKET=sar-lra-results
SAR_LRA_S3_PREFIX=jobs
AWS_DEFAULT_REGION=us-east-1

SAR_LRA_JOB_RETENTION_SECONDS=86400
SAR_LRA_JOB_TIMEOUT_SECONDS=3600
SAR_LRA_JOB_MAX_ATTEMPTS=3
SAR_LRA_MAX_QUEUED_JOBS=100
SAR_LRA_MIN_FREE_DISK_MB=1024

SAR_LRA_API_MEMORY_LIMIT=1g
SAR_LRA_API_CPUS=1.0
SAR_LRA_API_PIDS_LIMIT=256
SAR_LRA_WORKER_MEMORY_LIMIT=8g
SAR_LRA_WORKER_CPUS=4.0
SAR_LRA_WORKER_PIDS_LIMIT=512

# Microsoft Planetary Computer Sentinel-1 RTC access. Keep this secret out of images/repositories.
PC_SDK_SUBSCRIPTION_KEY=

# Remote acquisition provider: auto | planetary-computer | earth-engine
SAR_LRA_ACQUISITION_PROVIDER=auto

# Earth Engine: mount credentials read-only and set the in-container path when using EE.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gee.json
