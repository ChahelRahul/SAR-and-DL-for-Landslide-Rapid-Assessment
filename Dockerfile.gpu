# syntax=docker/dockerfile:1.7
# Optional NVIDIA GPU runtime for SAR-LRA.
# The base Python image is kept identical to the CPU image. TensorFlow's
# `and-cuda` extra supplies CUDA/cuDNN user-space libraries; the host supplies
# the NVIDIA driver through NVIDIA Container Toolkit.
ARG PYTHON_IMAGE=python:3.11.13-slim-bookworm@sha256:86adf8dbadc3d6e82ee5dd2c74bec2e1c2467cdad47886280501df722372d2e1
FROM --platform=linux/amd64 ${PYTHON_IMAGE}

LABEL org.opencontainers.image.title="SAR-LRA GPU"
LABEL org.opencontainers.image.description="Optional NVIDIA-GPU Sentinel-1 SAR landslide rapid-assessment CLI"
LABEL org.opencontainers.image.version="2.0.0"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.variant="gpu"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    SAR_LRA_CONTAINER=1 \
    SAR_LRA_ACCELERATOR=gpu \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    HOME=/home/sarlra

WORKDIR /opt/sar-lra

# Rasterio/GDAL wheels dynamically link against Expat on Debian slim.
# Install the runtime library explicitly so importing rasterio works in the
# final image (libexpat.so.1 is provided by the libexpat1 package).
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/docker-gpu.txt /tmp/docker-gpu.txt
RUN python -m pip install --upgrade "pip==25.2" \
    && python -m pip install --only-binary=:all: -r /tmp/docker-gpu.txt

COPY pyproject.toml README.md LICENSE MODEL_CARD.md ./
COPY app ./app
COPY config ./config
COPY model ./model
COPY schemas ./schemas
COPY scripts ./scripts
RUN chmod 0755 /opt/sar-lra/scripts/*.sh
COPY docs ./docs
COPY examples ./examples

# A GPU is intentionally not required at image-build time. Runtime GPU
# availability is checked by scripts/container_gpu_smoke_test.py.
RUN python -m pip install --no-deps . \
    && python scripts/verify_model_weights.py \
    && sar-lra --help >/dev/null \
    && sar-lra-api --help >/dev/null \
    && python - <<'PY'
import tensorflow as tf
assert tf.__version__ == "2.18.0", tf.__version__
print("TensorFlow", tf.__version__, "GPU-capable runtime installed")
PY

RUN groupadd --system --gid 10001 sarlra \
    && useradd --system --uid 10001 --gid 10001 --create-home --home-dir /home/sarlra sarlra \
    && mkdir -p /input /output \
    && chown -R 10001:10001 /home/sarlra /output \
    && chmod 0555 /input

USER 10001:10001
WORKDIR /work

VOLUME ["/input", "/output"]
ENTRYPOINT ["sar-lra"]
CMD ["--help"]
